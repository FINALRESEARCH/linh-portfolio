{
  "name": "linh-portfolio",
  "private": true,
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "sanity": "^6.4.0",
    "react-is": "^19.2.7"
  },
  "workspaces": [
    "cms",
    "ui"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typegen": "turbo run typegen --filter=cms",
    "lint": "turbo run lint --continue",
    "scrape:webflow": "node scripts/scrape-webflow-live.mjs > scripts/webflow-inventory.json",
    "import:sanity": "node scripts/import-to-sanity.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
